{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:$PATH\" \"$HOME/.local/share/claude-sync/claude-sync\" sync",
            "timeout": 60,
            "statusMessage": "Syncing Claude config"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{const os=require('os'),p=require('path');const d=process.env.CLAUDE_CONFIG_DIR||p.join(os.homedir(),'.claude');process.stdout.write(require('fs').readFileSync(p.join(d,'professional-mode.md'),'utf8'))}catch(e){}\"",
            "timeout": 5,
            "statusMessage": "Loading professional mode"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{const os=require('os'),p=require('path');const d=process.env.CLAUDE_CONFIG_DIR||p.join(os.homedir(),'.claude');process.stdout.write(require('fs').readFileSync(p.join(d,'superdinq-mode.md'),'utf8'))}catch(e){}\"",
            "timeout": 5,
            "statusMessage": "Loading superdinq mode"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write('PROFESSIONAL MODE ACTIVE — concise, substance stays.')\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write('SUPERDINQ MODE ACTIVE — YAGNI, stdlib first, shortest diff.')\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline/statusline.mjs"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}